# Force consistent line endings so working on the repo from Windows (Visual Studio,
# explorer copy) and WSL / cross-platform editors does not generate diff noise.

* text=auto eol=crlf

# Sources and project files: CRLF (Windows-native .NET tooling)
*.cs        text eol=crlf working-tree-encoding=UTF-8
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.resx      text eol=crlf
*.config    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.settings  text eol=crlf

# Docs and YAML: LF (most cross-platform)
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf

# SVGs are text; XML-like, LF is fine
*.svg       text eol=lf

# Binary assets: never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.tik       binary
*.tmd       binary
*.cert      binary
*.cetk      binary
*.tad       binary
*.sys       binary
*.app       binary
*.wua       binary
*.cia       binary
*.wad       binary
